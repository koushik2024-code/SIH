APP_NAME=NTRO Content Transformation Platform
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_MINUTES=60
CITATION_TOKEN_MINUTES=10
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=3000
DIRECT_MAX_TOKENS=6000
DIRECT_MAX_DOCUMENTS=5
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MODELS_LOCAL_ONLY=true
QDRANT_MODE=local
QDRANT_PATH=./data/qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=ntro_evidence
RAG_TOP_K=6
RAG_CANDIDATES=15
ENABLE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=200
MAX_URL_MB=20
MAX_SOURCE_CHARS=5000000
MAX_ARCHIVE_MB=500
MAX_PDF_PAGES=1000
MAX_MEDIA_SECONDS=7200
REQUEST_TIMEOUT_SECONDS=20
MEDIA_TIMEOUT_SECONDS=900
FFMPEG_EXE=ffmpeg
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TESSERACT_CMD=
OCR_LANGUAGES=eng
PIPER_EXE=
PIPER_MODEL=
VIDEO_FONT=
MEDIA_LIBRARY=./data/media_library
DATA_DIR=./data
DEBUG=false

# Studio editing and external services
REVISION_MODEL=qwen2.5:1.5b
ENABLE_WEB_IMAGES=true
MEDIA_USER_AGENT=NTRO-Content-Studio/3.0 (local research prototype)
ALLOW_EXTERNAL_PUBLISH=true
LINKEDIN_API_VERSION=202608
SMTP_ALLOWED_HOSTS=["smtp.gmail.com","smtp.office365.com","smtp.mail.yahoo.com"]
# Map ISO codes to installed Piper .onnx voices and Unicode font files.
PIPER_VOICES={}
VIDEO_FONTS={}

